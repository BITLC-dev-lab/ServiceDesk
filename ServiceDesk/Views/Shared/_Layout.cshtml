@{
  var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] | ServiceDesk</title>
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
  <div class="app-shell">
    <header class="sd-header">
      <div class="container-xl header-row">
        <a class="brand" asp-controller="Tickets" asp-action="Index" aria-label="ServiceDesk Startseite">
          <span class="brand-mark" aria-hidden="true">
            <span class="brand-mark-letter">S</span>
            <span class="brand-mark-accent"></span>
          </span>
          <span class="brand-copy">
            <strong>ServiceDesk</strong>
            <small>Westfalen Office Solutions GmbH</small>
          </span>
        </a>
        <nav class="sd-nav" aria-label="Hauptnavigation">
          <a
            class="nav-link @(currentController == "Tickets" ? "active" : null)"
            asp-controller="Tickets"
            asp-action="Index"
            aria-current="@(currentController == "Tickets" ? "page" : null)"
          >Tickets</a>
          <a
            class="nav-link @(currentController == "Employees" ? "active" : null)"
            asp-controller="Employees"
            asp-action="Index"
            aria-current="@(currentController == "Employees" ? "page" : null)"
          >Mitarbeiter</a>
          <a
            class="nav-link @(currentController == "Categories" ? "active" : null)"
            asp-controller="Categories"
            asp-action="Index"
            aria-current="@(currentController == "Categories" ? "page" : null)"
          >Kategorien</a>
        </nav>
      </div>
    </header>

    <main class="container-xl py-4 py-md-5">
      @RenderBody()
    </main>

    <footer class="sd-footer">
      <div class="container-xl footer-row">
        <strong>ServiceDesk</strong>
        <span>Westfalen Office Solutions GmbH</span>
        <span>Dortmund © 2026</span>
      </div>
    </footer>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>