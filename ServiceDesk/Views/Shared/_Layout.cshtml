@{
	var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="de">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@ViewData["Title"] | OmniFix</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
		  rel="stylesheet" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
	<div class="app-shell">
		<header class="sd-header">
			<div class="container-xl header-row">
				<a class="brand" asp-controller="Tickets" asp-action="Index" aria-label="OmniFix Startseite">
					<span class="brand-mark" aria-hidden="true">
						<svg class="brand-logo-svg" viewBox="0 0 24 24">
							<circle cx="12" cy="12" r="9" />
							<path d="M14.7 9.3a2.5 2.5 0 0 0-3.4 3.4l-2.6 2.6a1 1 0 0 0 1.4 1.4l2.6-2.6a2.5 2.5 0 0 0 3.4-3.4l-1.2 1.2-1.4-1.4 1.2-1.2Z" />
						</svg>
						<span class="brand-mark-accent"></span>
					</span>
					<span class="brand-copy">
						<strong>OmniFix</strong>
						<small>Westfalen Office Solutions GmbH</small>
					</span>
				</a>
				<nav class="sd-nav" aria-label="Hauptnavigation">
					<a class="nav-link @(currentController == "Dashboard" ? "active" : null)"
					   asp-controller="Dashboard"
					   asp-action="Index"
					   aria-current="@(currentController == "Dashboard" ? "page" : null)">Dashboard</a>
					<a class="nav-link @(currentController == "Tickets" ? "active" : null)"
					   asp-controller="Tickets"
					   asp-action="Index"
					   aria-current="@(currentController == "Tickets" ? "page" : null)">Tickets</a>
					<a class="nav-link @(currentController == "Employees" ? "active" : null)"
					   asp-controller="Employees"
					   asp-action="Index"
					   aria-current="@(currentController == "Employees" ? "page" : null)">Mitarbeiter</a>
					<a class="nav-link @(currentController == "Categories" ? "active" : null)"
					   asp-controller="Categories"
					   asp-action="Index"
					   aria-current="@(currentController == "Categories" ? "page" : null)">Kategorien</a>
				</nav>
			</div>
		</header>

		<main class="container-xl py-4 py-md-5">
			@RenderBody()
		</main>

		<footer class="sd-footer">
			<div class="container-xl footer-row">
				<strong>ServiceDesk</strong>
				<span>Westfalen Office Solutions GmbH</span>
				<span>Dortmund © 2026</span>
			</div>
		</footer>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>