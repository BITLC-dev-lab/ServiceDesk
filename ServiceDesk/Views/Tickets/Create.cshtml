@model ServiceDesk.ViewModels.TicketFormViewModel
@{
	ViewData["Title"] = "Neues Ticket";
}

<div class="form-page">
	<a class="back-link d-inline-block mb-3" asp-controller="Tickets" asp-action="Index">← Zurück zu Tickets</a>
	<h1 class="h3 mb-1">Neues Ticket</h1>
	<p class="text-secondary mb-4">Erfassen Sie ein neues IT-Support-Ticket.</p>
	<form class="card sd-card" asp-controller="Tickets" asp-action="Create" method="post">
		<div class="card-body p-4">
			<div class="mb-3">
				<label class="form-label fw-medium" asp-for="Title">
					Title <span class="text-danger">*</span>
				</label>
				<input asp-for="Title" class="form-control"/>
				<span asp-validation-for="Title" class="text-danger"></span>
			</div>
			<div class="mb-3">
				<label class="form-label fw-medium" asp-for="Description">
					Beschreibung <span class="text-danger">*</span>
				</label>
				<textarea asp-for="Description" class="form-control" rows="5"></textarea>
				<span asp-validation-for="Description" class="text-danger"></span>
			</div>
			<div class="row g-3">
				<div class="col-md-6 mb-3">
					<label class="form-label fw-medium" asp-for="CategoryId">Kategorie<span class="text-danger">*</span></label>
					<select class="form-select" asp-for="CategoryId">
						<option value="">Bitte auswählen</option>
						@foreach (var category in Model.Categories)
						{
							<option value="@category.Id">@category.Name</option>
						}
					</select>
					<span asp-validation-for="CategoryId" class="text-danger"></span>
				</div>
				<div class="col-md-6 mb-3">
					<label class="form-label fw-medium" asp-for="Priority">
						Priorität <span class="text-danger">*</span>
					</label>
					<select class="form-select" asp-for="Priority">
					<option value="">Bitte auswählen</option>
						@foreach (var priority in Model.Priorities)
						{
							<option value="@priority">@priority</option>
						}
					</select>
					<span asp-validation-for="Priority" class="text-danger"></span>
				</div>
			</div>
			<div class="mb-3">
				<label class="form-label fw-medium" for="EmployeeId">Zuständiger Mitarbeiter</label>
				<select class="form-select" asp-for="EmployeeId">
					<option value="">Nicht zugewiesen</option>
					@foreach (var employee in Model.Employees)
					{
						<option value="@employee.Id">@($"{employee.LastName} {employee.FirstName}")</option>
					}
					
				</select>
			</div>
		</div>
		<div class="card-footer bg-white d-flex justify-content-end gap-2 p-3">
			<a class="btn btn-outline-secondary" asp-controller="Tickets" asp-action="Index">Abbrechen</a>
			<button class="btn btn-primary" type="submit">Ticket erstellen</button>
		</div>
	</form>
</div>

      