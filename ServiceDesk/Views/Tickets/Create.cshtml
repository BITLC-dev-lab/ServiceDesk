@model ServiceDesk.ViewModels.TicketFormViewModel
@{
	ViewData["Title"] = "Neues Ticket";
}

<div class="form-page">
	<a class="back-link d-inline-block mb-3" asp-controller="Tickets" asp-action="Index">← Zurück zu Tickets</a>
	<h1 class="h3 mb-1">Neues Ticket</h1>
	<p class="text-secondary mb-4">Erfassen Sie ein neues IT-Support-Ticket.</p>
	<form class="card sd-card" method="post" novalidate>
		<div class="card-body p-4">
			<div class="mb-3">
				<label class="form-label fw-medium" for="title">
					Titel <span class="text-danger">*</span>
				</label>
				<input class="form-control is-invalid" id="title" name="Titel" required />
				<div class="invalid-feedback">Bitte geben Sie einen Titel ein.</div>
			</div>
			<div class="mb-3">
				<label class="form-label fw-medium" for="description">
					Beschreibung <span class="text-danger">*</span>
				</label>
				<textarea class="form-control is-invalid" id="description" name="Beschreibung" rows="5" required>
        </textarea>
				<div class="invalid-feedback">Bitte geben Sie eine Beschreibung ein.</div>
			</div>
			<div class="row g-3">
				<div class="col-md-6 mb-3">
					<label class="form-label fw-medium" for="category">Kategorie<span class="text-danger">*</span></label>
					<select class="form-select is-invalid" id="category" name="KategorieId" required>
						<option value="">Bitte auswählen</option>
						<option>Hardware</option>
						<option>Software</option>
						<option>Netzwerk</option>
						<option>Berechtigungen</option>
					</select>
					<div class="invalid-feedback">Bitte wählen Sie eine Kategorie aus.</div>
				</div>
				<div class="col-md-6 mb-3">
					<label class="form-label fw-medium" for="priority">
						Priorität <span class="text-danger">*</span>
					</label>
					<select class="form-select" id="priority" name="Prioritaet" required>
						<option>Niedrig</option>
						<option selected>Mittel</option>
						<option>Hoch</option>
					</select>
				</div>
			</div>
			<div class="mb-3">
				<label class="form-label fw-medium" for="employee">Zuständiger Mitarbeiter</label>
				<select class="form-select" id="employee" name="MitarbeiterId">
					<option value="">Nicht zugewiesen</option>
					<option>Lena Hoffmann</option>
					<option>Jonas Becker</option>
					<option>Mehmet Yilmaz</option>
				</select>
			</div>
		</div>
		<div class="card-footer bg-white d-flex justify-content-end gap-2 p-3">
			<a class="btn btn-outline-secondary" asp-controller="Tickets" asp-action="Index">Abbrechen</a>
			<button class="btn btn-primary" type="submit">Ticket erstellen</button>
		</div>
	</form>
</div>

      