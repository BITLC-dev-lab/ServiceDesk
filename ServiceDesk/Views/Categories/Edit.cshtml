@model ServiceDesk.Models.Category

@{
    ViewData["Title"] = "Kategorie bearbeiten";
}

<div class="form-page">
    <a class="back-link d-inline-block mb-3"
       asp-controller="Categories"
       asp-action="Index">
        ← Zurück zu Kategorien
    </a>
    <h1 class="h3 mb-1">
        Kategorie bearbeiten
    </h1>
    <p class="text-secondary mb-4">Kategorienamen aktualisieren.</p>
    <form class="card sd-card"
          asp-action="Edit"
          method="post">
        <input type="hidden" asp-for="Id" />
        <div class="card-body p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-medium">
                    Kategoriename
                    <span class="text-danger">*</span>
                </label>
                <input asp-for="Name" class="form-control" maxlength="1000"/>
                <div class="invalid-feedback">
                    Bitte geben Sie einen Namen ein.
                </div>
            </div>
        </div>
        <div class="card-footer
            bg-white
            d-flex
            justify-content-end
            gap-2
            p-3">
            <a class="btn btn-outline-secondary"
               asp-controller="Categories"
               asp-action="Index">
                Abbrechen
            </a>
            <button class="btn btn-primary" type="submit">Speichern</button>
        </div>
    </form>
</div>


      
